{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "football-data-app",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "data.brewerlabs.uk",
      "custom_domain": true
    }
  ]
}
